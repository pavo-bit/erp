# ═══════════════════════════════════════════════════════════════════════
# SSVM College Square — Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# ─── Database Configuration ───────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=ssvm_platform
DATABASE_URL_AUTH="postgresql://ssvm_auth:auth_password@database:5432/ssvm_platform"
DATABASE_URL_TRUSTED="postgresql://ssvm_trusted:trusted_password@database:5432/ssvm_platform"

# ─── Application Ports ────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=5000
DATABASE_PORT=5432

# ─── Security ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_EXPIRES_IN=7d

# ─── Environment ──────────────────────────────────────────────────────
NODE_ENV=production
