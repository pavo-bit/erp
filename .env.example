# Copy to .env and replace every placeholder before starting Compose.
# Generate separate URL-safe hex passwords with:
# node -p "require('crypto').randomBytes(32).toString('hex')"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_OWNER_PASSWORD
POSTGRES_DB=ssvm_platform

POSTGRES_APP_USER=ssvm_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_UNIQUE_64_CHARACTER_HEX_PASSWORD
POSTGRES_MIGRATOR_USER=ssvm_migrator
POSTGRES_MIGRATOR_PASSWORD=REPLACE_WITH_DIFFERENT_64_CHARACTER_HEX_PASSWORD

FRONTEND_PORT=3000
BACKEND_PORT=5000
DATABASE_PORT=5432

JWT_SECRET=REPLACE_WITH_UNIQUE_128_CHARACTER_HEX_SECRET
JWT_EXPIRES_IN=7d
NODE_ENV=production
