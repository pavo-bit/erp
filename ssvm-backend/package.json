{
  "name": "ssvm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:esm": "node scripts/check-esm.js",
    "test:api": "vitest run src/tests/api/",
    "test:unit": "vitest run src/tests/unit/",
    "test:rls": "vitest run --config vitest.rls.config.ts --pool=threads",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=test-results.xml --no-file-parallelism",
    "lint": "eslint src/ --max-warnings 0",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:tenant-classification": "node scripts/generate-tenant-classification.cjs --write",
    "db:tenant-classification:check": "node scripts/generate-tenant-classification.cjs --check",
    "db:verify-diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "db:verify-tables": "tsx scripts/verify-database-schema.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "generate:openapi": "tsx src/openapi/generate.ts > openapi.json",
    "test:dr": "tsx scripts/dr-test.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1067.0",
    "@aws-sdk/client-secrets-manager": "^3.1070.0",
    "@aws-sdk/s3-request-presigner": "^3.1067.0",
    "@bull-board/api": "^8.0.0",
    "@bull-board/express": "^8.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@prisma/client": "^6.9.0",
    "@prisma/instrumentation": "^7.8.0",
    "@sentry/node": "^10.57.0",
    "@sentry/profiling-node": "^10.57.0",
    "@types/pino": "^7.0.4",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.78.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "file-type": "^16.5.4",
    "handlebars": "^4.7.9",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "otplib": "^13.4.1",
    "papaparse": "^5.5.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.1",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "razorpay": "^2.9.6",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.2",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/handlebars": "^4.0.40",
    "@types/ioredis-mock": "^8.2.7",
    "@types/jest": "^30.0.0",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/otplib": "^7.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.4.2",
    "prisma": "^6.9.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.8"
  }
}
