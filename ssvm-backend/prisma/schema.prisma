generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id                                                                    String                       @id @default(cuid())
  name                                                                  String
  code                                                                  String                       @unique
  address                                                               String?
  city                                                                  String?
  state                                                                 String?
  phone                                                                 String?
  email                                                                 String?
  logo                                                                  String?
  website                                                               String?
  boardType                                                             String?
  status                                                                SchoolStatus                 @default(TRIAL)
  isActive                                                              Boolean                      @default(true)
  onboardingDone                                                        Boolean                      @default(false)
  createdAt                                                             DateTime                     @default(now())
  updatedAt                                                             DateTime                     @updatedAt
  deletedAt                                                             DateTime?
  deletedById                                                           String?
  schoolGroupId                                                         String?
  tenantState                                                           TenantState                  @default(PROVISIONING)
  AccountingPeriod                                                      AccountingPeriod[]
  BankReconciliation                                                    BankReconciliation[]
  Budget                                                                Budget[]
  RazorpayReconciliation                                                RazorpayReconciliation[]
  DailyRevenueProjection                                                DailyRevenueProjection[]
  DeferredRevenueSchedule                                               DeferredRevenueSchedule[]
  DomainEvent                                                           DomainEvent[]
  FinancialApprovalPolicy                                               FinancialApprovalPolicy[]
  FinancialAudit                                                        FinancialAudit[]
  FinancialClose                                                        FinancialClose[]
  FinancialDimension                                                    FinancialDimension[]
  FinancialReportCache                                                  FinancialReportCache[]
  FiscalYear                                                            FiscalYear[]
  InterCompanyTransaction_InterCompanyTransaction_fromSchoolIdToschools InterCompanyTransaction[]    @relation("InterCompanyTransaction_fromSchoolIdToschools")
  InterCompanyTransaction_InterCompanyTransaction_toSchoolIdToschools   InterCompanyTransaction[]    @relation("InterCompanyTransaction_toSchoolIdToschools")
  JournalTemplate                                                       JournalTemplate[]
  LedgerAccount                                                         LedgerAccount[]
  LedgerEvent                                                           LedgerEvent[]
  LedgerIntegrityReport                                                 LedgerIntegrityReport[]
  LedgerMerkleRoot                                                      LedgerMerkleRoot[]
  LedgerSnapshot                                                        LedgerSnapshot[]
  LedgerTransaction                                                     LedgerTransaction[]
  PolicyDefinition                                                      PolicyDefinition[]
  PostingRule                                                           PostingRule[]
  SSOConfiguration                                                      SSOConfiguration?
  integrations                                                          SchoolIntegration[]
  SequenceCounter                                                       SequenceCounter[]
  StudentFinancialProjection                                            StudentFinancialProjection[]
  webhookDeliveries                                                     WebhookDelivery[]
  WorkflowDefinition                                                    WorkflowDefinition[]
  sessions                                                              AcademicSession[]
  accessReviews                                                         AccessReview[]
  activityLogs                                                          ActivityLog[]
  admissionEnquiries                                                    AdmissionEnquiry[]
  admissions                                                            Admission[]
  archiveJobLogs                                                        ArchiveJobLog[]
  assetCategories                                                       AssetCategory[]
  assets                                                                Asset[]
  assignments                                                           Assignment[]
  attendance                                                            Attendance[]
  auditLogs                                                             AuditLog[]
  bookIssues                                                            BookIssue[]
  books                                                                 Book[]
  branches                                                              Branch[]
  brandSettings                                                         BrandSettings?
  bulkJobs                                                              BulkJob[]
  certificateTemplates                                                  CertificateTemplate[]
  classes                                                               Class[]
  communicationLogs                                                     CommunicationLog[]
  communicationTemplates                                                CommunicationTemplate[]
  consentRecords                                                        ConsentRecord[]
  contracts                                                             Contract[]
  customDomainRecord                                                    CustomDomain?
  dataClassifications                                                   DataClassification[]
  departments                                                           Department[]
  documentRepo                                                          DocumentRepository[]
  documents                                                             Document[]
  events                                                                Event[]
  exams                                                                 Exam[]
  feeCategories                                                         FeeCategory[]
  feeStructures                                                         FeeStructure[]
  financialPeriods                                                      FinancialPeriod[]
  fineRules                                                             FineRule[]
  galleryImages                                                         GalleryImage[]
  helpdeskTickets                                                       HelpdeskTicket[]
  hostelAllocations                                                     HostelAllocation[]
  hostelRooms                                                           HostelRoom[]
  incidentReports                                                       IncidentReport[]
  invoices                                                              Invoice[]
  legalHolds                                                            LegalHold[]
  messageTemplates                                                      MessageTemplate[]
  messageThreads                                                        MessageThread[]
  notices                                                               Notice[]
  notificationDeliveries                                                NotificationDelivery[]
  notificationTemplates                                                 NotificationTemplate[]
  notifications                                                         Notification[]
  onboardingProgress                                                    OnboardingProgress?
  permissionGroups                                                      PermissionGroup[]
  purchaseOrders                                                        PurchaseOrder[]
  receptionCallLogs                                                     ReceptionCallLog[]
  receptionComplaints                                                   ReceptionComplaint[]
  reportTemplates                                                       ReportTemplate[]
  salaries                                                              Salary[]
  scholarships                                                          Scholarship[]
  archive                                                               SchoolArchive?
  schoolFeatures                                                        SchoolFeature[]
  schoolSettings                                                        SchoolSettings?
  settingsHistory                                                       SchoolSettingsHistory[]
  SchoolGroup                                                           SchoolGroup?                 @relation(fields: [schoolGroupId], references: [id])
  siteContent                                                           SiteContent[]
  storageObjects                                                        StorageObject[]
  students                                                              Student[]
  studyMaterials                                                        StudyMaterial[]
  subjects                                                              Subject[]
  subscriptionPayments                                                  SubscriptionPayment[]
  subscription                                                          Subscription?
  supportTickets                                                        SupportTicket[]
  systemLogs                                                            SystemLog[]
  teacherSubjectAssignments                                             TeacherSubjectAssignment[]
  teachers                                                              Teacher[]
  testimonials                                                          Testimonial[]
  timetables                                                            Timetable[]
  transportAllocations                                                  TransportAllocation[]
  transportRoutes                                                       TransportRoute[]
  transportVehicles                                                     TransportVehicle[]
  templates                                                             Template[]
  usageMetrics                                                          UsageMetric[]
  userConsents                                                          UserConsent[]
  delegations                                                           UserDelegation[]
  vendors                                                               Vendor[]
  visitorLogs                                                           VisitorLog[]
  webhookEndpoints                                                      WebhookEndpoint[]

  @@map("schools")
}

model Branch {
  id           String        @id @default(cuid())
  schoolId     String
  name         String
  address      String?
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  admissions   Admission[]
  attendances  Attendance[]
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  events       Event[]
  invoices     Invoice[]
  notices      Notice[]
  salaries     Salary[]
  scholarships Scholarship[]
  students     Student[]
  teachers     Teacher[]

  @@map("branches")
}

model Subscription {
  id         String                 @id @default(cuid())
  schoolId   String                 @unique
  planId     String
  amount     Float                  @default(0)
  startDate  DateTime               @default(now())
  endDate    DateTime
  status     String                 @default("ACTIVE")
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  payments   SubscriptionPayment[]
  planConfig SubscriptionPlanConfig @relation(fields: [planId], references: [id])
  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model SubscriptionPlanConfig {
  id            String         @id @default(cuid())
  name          String
  description   String?
  fixedPrice    Float
  billingCycle  String
  features      String         @default("[]")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("subscription_plan_configs")
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  schoolId       String
  subscriptionId String
  amountPaid     Float
  paymentMethod  String
  transactionRef String?
  paymentDate    DateTime     @default(now())
  remarks        String?
  createdAt      DateTime     @default(now())
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  name                    String
  role                    Role
  phone                   String?
  avatar                  String?
  schoolId                String?
  branchId                String?
  employeeId              String?
  department              String?
  isActive                Boolean                  @default(true)
  lastLogin               DateTime?
  twoFactorSecret         String?
  twoFactorEnabled        Boolean                  @default(false)
  twoFactorBackupCodes    String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  deletedById             String?
  mustChangePassword      Boolean                  @default(false)
  passwordChangedAt       DateTime?
  FederatedUser           FederatedUser[]
  accessReviewsGiven      AccessReview[]           @relation("AccessReviewer")
  accessReviewsTargeted   AccessReview[]           @relation("AccessReviewTarget")
  alumni                  Alumni?
  assetsAssignedByMe      AssetAssignment[]        @relation("AssetAssigner")
  assetAssignments        AssetAssignment[]        @relation("AssetAssignee")
  assetTransfers          AssetTransfer[]
  auditLogs               AuditLog[]               @relation("AuditUser")
  events                  Event[]                  @relation("EventCreator")
  financialPeriods        FinancialPeriod[]
  guardian                Guardian?
  assignedTickets         HelpdeskTicket[]         @relation("TicketAssignee")
  requestedTickets        HelpdeskTicket[]         @relation("TicketRequester")
  reportedIncidents       IncidentReport[]         @relation("Reporter")
  issuedCertificates      IssuedCertificate[]
  legalHoldsPlaced        LegalHold[]              @relation("LegalHoldPlacer")
  legalHoldsReleased      LegalHold[]              @relation("LegalHoldReleaser")
  messageParticipants     MessageParticipant[]
  messages                Message[]
  notices                 Notice[]                 @relation("NoticeAuthor")
  notificationDeliveries  NotificationDelivery[]   @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[]
  purchaseOrders          PurchaseOrder[]
  refreshTokens           RefreshToken[]
  approvedScholarships    Scholarship[]            @relation("ScholarshipApprover")
  archivesCreated         SchoolArchive[]
  settingsHistoryChanges  SchoolSettingsHistory[]
  storageObjects          StorageObject[]
  student                 Student?
  supportMessages         SupportMessage[]
  supportTickets          SupportTicket[]
  systemLogs              SystemLog[]
  teacher                 Teacher?
  transportVehicles       TransportVehicle[]
  userConsents            UserConsent[]
  delegationsReceived     UserDelegation[]         @relation("DelegateeRelation")
  delegationsGiven        UserDelegation[]         @relation("DelegatorRelation")
  userDevices             UserDevice[]
  sessions                UserSession[]
  webhookEndpoints        WebhookEndpoint[]

  @@index([role])
  @@index([schoolId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_users_name_trgm")
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(cuid())
  token             String    @unique
  userId            String
  expiresAt         DateTime
  revokedAt         DateTime?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  familyId          String?
  replacedBy        String?
  deviceFingerprint String?
  isRevoked         Boolean   @default(false)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([familyId])
  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}

model OTP {
  id            String    @id @default(cuid())
  phone         String
  code          String
  expiresAt     DateTime
  verified      Boolean   @default(false)
  attemptCount  Int       @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([phone, code])
  @@index([phone, verified])
  @@map("otps")
}

model AcademicSession {
  id                        String                     @id @default(cuid())
  schoolId                  String
  name                      String
  startDate                 DateTime
  endDate                   DateTime
  isCurrent                 Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes                   Class[]
  teacherSubjectAssignments TeacherSubjectAssignment[]

  @@unique([schoolId, name])
  @@map("academic_sessions")
}

model Class {
  id             String          @id @default(cuid())
  schoolId       String
  sessionId      String
  name           String
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assignments    Assignment[]
  classSubjects  ClassSubject[]
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exams          Exam[]
  feeStructures  FeeStructure[]
  sections       Section[]
  studyMaterials StudyMaterial[]

  @@unique([schoolId, sessionId, name])
  @@map("classes")
}

model Section {
  id                        String                     @id @default(cuid())
  classId                   String
  name                      String
  capacity                  Int?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  attendance                Attendance[]
  classTeachers             ClassTeacher[]
  class                     Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  students                  Student[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  timetables                Timetable[]

  @@unique([classId, name])
  @@map("sections")
}

model ClassTeacher {
  id        String   @id @default(cuid())
  sectionId String
  teacherId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([sectionId, teacherId])
  @@map("class_teachers")
}

model Department {
  id          String    @id @default(cuid())
  schoolId    String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers    Teacher[]

  @@unique([schoolId, name])
  @@map("departments")
}

model Teacher {
  id                        String                     @id @default(cuid())
  userId                    String                     @unique
  schoolId                  String
  branchId                  String?
  departmentId              String?
  employeeId                String?
  designation               String?
  qualification             String?
  experience                String?
  subjects                  String                     @default("")
  joiningDate               DateTime?
  photo                     String?
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  deletedById               String?
  assignments               Assignment[]
  markedAttendance          Attendance[]               @relation("AttendanceMarker")
  classTeachers             ClassTeacher[]
  leaveRequests             LeaveRequest[]             @relation("LeaveRequester")
  salaries                  Salary[]
  teacherAttendance         TeacherAttendance[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  teacherSubjects           TeacherSubject[]
  branch                    Branch?                    @relation(fields: [branchId], references: [id])
  department                Department?                @relation(fields: [departmentId], references: [id])
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("teachers")
}

model Guardian {
  id              String          @id @default(cuid())
  userId          String?         @unique
  schoolId        String
  primaryName     String
  primaryPhone    String
  primaryEmail    String?
  primaryRelation String          @default("Father")
  secondaryName   String?
  secondaryPhone  String?
  address         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  consentRecords  ConsentRecord[]
  user            User?           @relation(fields: [userId], references: [id])
  students        Student[]

  @@map("guardians")
}

model Student {
  id                         String                      @id @default(cuid())
  schoolId                   String
  branchId                   String?
  sectionId                  String?
  guardianId                 String?
  rollNo                     String
  admissionNo                String?                     @unique
  password                   String?
  name                       String
  dob                        DateTime?
  gender                     String?
  bloodGroup                 String?
  address                    String?
  photo                      String?
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  deletedAt                  DateTime?
  deletedById                String?
  userId                     String?                     @unique
  StudentFinancialProjection StudentFinancialProjection?
  submissions                AssignmentSubmission[]
  attendance                 Attendance[]
  hostelAllocations          HostelAllocation[]
  incidentReports            IncidentReport[]
  invoices                   Invoice[]
  issuedCertificates         IssuedCertificate[]
  scholarships               Scholarship[]
  marks                      StudentMark[]
  timelines                  StudentTimeline[]
  branch                     Branch?                     @relation(fields: [branchId], references: [id])
  guardian                   Guardian?                   @relation(fields: [guardianId], references: [id])
  school                     School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sectionRef                 Section?                    @relation(fields: [sectionId], references: [id])
  user                       User?                       @relation(fields: [userId], references: [id])
  transportAllocations       TransportAllocation[]

  @@index([schoolId])
  @@index([sectionId])
  @@index([rollNo, schoolId])
  @@index([admissionNo])
  @@index([schoolId, sectionId])
  @@index([guardianId])
  @@index([schoolId, admissionNo])
  @@index([schoolId, isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_students_name_trgm")
  @@map("students")
}

model StudentTimeline {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  type        String
  description String?
  date        DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_timeline")
}

model Alumni {
  id            String         @id @default(cuid())
  userId        String         @unique
  batch         String
  currentRole   String?
  company       String?
  achievement   String?
  isFeatured    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions Contribution[]

  @@map("alumni")
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  schoolId   String
  sectionId  String?
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  markedById String?
  remarks    String?
  createdAt  DateTime         @default(now())
  branchId   String?
  branch     Branch?          @relation(fields: [branchId], references: [id])
  markedBy   Teacher?         @relation("AttendanceMarker", fields: [markedById], references: [id])
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section    Section?         @relation(fields: [sectionId], references: [id])
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([schoolId, date])
  @@index([sectionId, date])
  @@index([schoolId, date, status])
  @@index([sectionId, date, status])
  @@map("attendance")
}

model TeacherAttendance {
  id        String           @id @default(cuid())
  teacherId String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime         @default(now())
  teacher   Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@index([teacherId, date])
  @@map("teacher_attendance")
}

model LeaveRequest {
  id              String      @id @default(cuid())
  requesterId     String
  requesterType   String      @default("TEACHER")
  leaveType       String      @default("CASUAL")
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  approverRemarks String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  requester       Teacher     @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([status])
  @@index([requesterId, status])
  @@map("leave_requests")
}

model Subject {
  id                        String                     @id @default(cuid())
  schoolId                  String
  name                      String
  code                      String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  assignments               Assignment[]
  classSubjects             ClassSubject[]
  examSubjects              ExamSubject[]
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjectAssignments TeacherSubjectAssignment[]
  teacherSubjects           TeacherSubject[]

  @@map("subjects")
}

model ClassSubject {
  id        String  @id @default(cuid())
  classId   String
  subjectId String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model TeacherSubject {
  id        String  @id @default(cuid())
  teacherId String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

model Timetable {
  id         String          @id @default(cuid())
  schoolId   String
  sectionId  String
  day        String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  slots      TimetableSlot[]
  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sectionRef Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([schoolId, sectionId])
  @@map("timetables")
}

model TimetableSlot {
  id                         String                   @id @default(cuid())
  timetableId                String
  period                     Int
  teacherSubjectAssignmentId String
  startTime                  String
  endTime                    String
  createdAt                  DateTime                 @default(now())
  teacherSubjectAssignment   TeacherSubjectAssignment @relation(fields: [teacherSubjectAssignmentId], references: [id], onDelete: Cascade)
  timetable                  Timetable                @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@index([timetableId])
  @@index([teacherSubjectAssignmentId])
  @@map("timetable_slots")
}

model Exam {
  id           String        @id @default(cuid())
  schoolId     String
  classId      String
  name         String
  startDate    DateTime?
  endDate      DateTime?
  isPublished  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isArchived   Boolean       @default(false)
  examSubjects ExamSubject[]
  classRef     Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, classId])
  @@map("exams")
}

model ExamSubject {
  id                 String        @id @default(cuid())
  examId             String
  subjectId          String
  examDate           DateTime?
  maxMarks           Float         @default(100)
  passMarks          Float         @default(33)
  theoryMaxMarks     Float?
  theoryPassMarks    Float?
  practicalMaxMarks  Float?
  practicalPassMarks Float?
  weightage          Float?
  exam               Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject            Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks              StudentMark[]

  @@unique([examId, subjectId])
  @@index([examId])
  @@map("exam_subjects")
}

model StudentMark {
  id                     String      @id @default(cuid())
  studentId              String
  examSubjectId          String
  marksObtained          Float
  grade                  String?
  remarks                String?
  theoryMarksObtained    Float?
  practicalMarksObtained Float?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  examSubject            ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student                Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, examSubjectId])
  @@index([studentId])
  @@index([examSubjectId])
  @@index([studentId, examSubjectId])
  @@map("student_marks")
}

model Notice {
  id         String       @id @default(cuid())
  schoolId   String?
  title      String
  content    String
  category   String       @default("General")
  status     NoticeStatus @default(DRAFT)
  attachment String?
  expiryDate DateTime?
  views      Int          @default(0)
  authorId   String
  createdAt  DateTime     @default(now())
