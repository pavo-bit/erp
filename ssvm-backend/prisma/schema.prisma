  name      String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  state     MasterState @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([stateId])
  @@map("mdm_cities")
}

model MasterReligion {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mdm_religions")
}

model MasterCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mdm_categories")
}

model MasterSubject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("mdm_subjects")
}

model MasterDepartment {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("mdm_departments")
}

model AccessReview {
  id            String             @id @default(cuid())
  schoolId      String
  reviewerId    String
  targetUserId  String
  status        AccessReviewStatus @default(PENDING)
  comments      String?
  reviewDate    DateTime?
  scheduledDate DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  reviewer      User               @relation("AccessReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  school        School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  targetUser    User               @relation("AccessReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, targetUserId])
  @@map("access_reviews")
}

model IncidentReport {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  reporterId   String
  type         String
  severity     String
  title        String
  description  String
  actionTaken  String?
  status       String   @default("OPEN")
  incidentDate DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@map("incident_reports")
}

model BackupValidation {
  id         String   @id @default(cuid())
  fileName   String
  status     String
  durationMs Int
  checksum   String
  verifiedAt DateTime @default(now())

  @@map("backup_validations")
}

model PurchaseRequest {
  id             String                @id @default(cuid())
  schoolId       String
  requestNumber  String                @unique
  requesterId    String
  departmentId   String?
  status         PRStatus              @default(DRAFT)
  justification  String?
  totalEstAmount Float                 @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@index([schoolId])
  @@index([schoolId, status])
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  itemId            String?
  description       String
  quantity          Float
  estimatedPrice    Float
  createdAt         DateTime        @default(now())
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  schoolId        String
  grNumber        String        @unique
  purchaseOrderId String
  receivedDate    DateTime      @default(now())
  receivedById    String
  remarks         String?
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([schoolId])
  @@index([purchaseOrderId])
}

model VendorInvoice {
  id              String         @id @default(cuid())
  schoolId        String
  invoiceNumber   String
  vendorId        String
  purchaseOrderId String?
  amount          Float
  status          String         @default("PENDING")
  dueDate         DateTime?
  createdAt       DateTime       @default(now())
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  vendor          Vendor         @relation(fields: [vendorId], references: [id])

  @@index([schoolId])
  @@index([vendorId])
  @@index([schoolId, status])
}

model InventoryLocation {
  id          String           @id @default(cuid())
  schoolId    String
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  stocks      InventoryStock[]

  @@index([schoolId])
}

model InventoryItem {
  id           String           @id @default(cuid())
  schoolId     String
  sku          String           @unique
  name         String
  categoryId   String?
  uom          String           @default("NOS")
  reorderLevel Float            @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  stocks       InventoryStock[]

  @@index([schoolId])
}

model InventoryStock {
  id          String            @id @default(cuid())
  schoolId    String
  itemId      String
  locationId  String
  quantity    Float             @default(0)
  lastUpdated DateTime          @updatedAt
  item        InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location    InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([schoolId])
}

model StockLedger {
  id            String                @id @default(cuid())
  schoolId      String
  itemId        String
  locationId    String
  movementType  InventoryMovementType
  quantity      Float
  balanceAfter  Float
  referenceDoc  String?
  performedById String
  timestamp     DateTime              @default(now())

  @@index([schoolId])
  @@index([itemId])
  @@index([locationId])
  @@index([schoolId, timestamp])
}

model DataRetentionPolicy {
  id            String   @id @default(cuid())
  schoolId      String
  entityName    String
  retentionDays Int
  action        String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, entityName])
  @@index([schoolId])
}

model CustomWorkflow {
  id               String         @id @default(cuid())
  schoolId         String
  name             String
  triggerEntity    String
  triggerCondition String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  steps            WorkflowStep[]

  @@index([schoolId, triggerEntity])
}

model WorkflowStep {
  id            String         @id @default(cuid())
  workflowId    String
  orderIndex    Int
  actionType    String
  actionPayload String
  createdAt     DateTime       @default(now())
  workflow      CustomWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

