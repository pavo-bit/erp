model FailedWebhook {
  id           String    @id @default(cuid())
  paymentId    String?
  payload      Json
  errorMessage String
  retryCount   Int       @default(0)
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())

  PaymentTransaction PaymentTransaction? @relation(fields: [paymentId], references: [id])
}

model AppConfiguration {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String // Stored as string, can be JSON or scalar
  type        String   @default("STRING") // STRING, BOOLEAN, NUMBER, JSON
  description String?
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  history ConfigHistory[]

  @@map("app_configurations")
}

model ConfigHistory {
  id              String   @id @default(cuid())
  configurationId String
  oldValue        String?
  newValue        String
  changedAt       DateTime @default(now())
  changedBy       String?
  reason          String?

  configuration AppConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@index([configurationId])
  @@map("config_history")
}
