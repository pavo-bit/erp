// ═══════════════════════════════════════════
// SSVM College Square — Prisma Schema v3.0
// Enterprise Multi-School ERP Platform (SaaS)
// ═══════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───

enum Role {
  SUPER_ADMIN
  ERP_ADMIN
  WEBSITE_ADMIN
  TEACHER
  ACCOUNTANT
  HR
  RECEPTIONIST
  ALUMNI
  PARENT
  STUDENT
  LIBRARIAN
  ASSET_MANAGER
}

enum DocumentOwnerType {
  STUDENT
  TEACHER
  ADMISSION
  STAFF
  SCHOOL
}

enum DocumentCategory {
  AADHAAR
  BIRTH_CERTIFICATE
  MARKSHEET
  TC
  ADMISSION_FORM
  PASSPORT
  OTHER
}

enum ActivityType {
  ADMISSION
  PAYMENT
  RESULT
  ATTENDANCE
  TEACHER
  NOTICE
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  PLANNING
  UPCOMING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
  PARTIAL
  UNPAID
}

enum FeeType {
  ADMISSION
  READMISSION
  MONTHLY
  EXAM
  TRANSPORT
  HOSTEL
  MISCELLANEOUS
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HOLIDAY
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE_SUBMITTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdmissionStatus {
  PENDING
  UNDER_REVIEW
  DOCUMENTS_VERIFIED
  INTERVIEW
  APPROVED
  REJECTED
  ENROLLED
}

enum NotificationType {
  SMS
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum SalaryStatus {
  PENDING
  PAID
  HOLD
}

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  ARCHIVED
}

// ═══════════════════════════════════════════
// SCHOOL & TENANT MANAGEMENT
// ═══════════════════════════════════════════

model School {
  id             String       @id @default(cuid())
  name           String
  code           String       @unique
  address        String?
  city           String?
  state          String?
  phone          String?
  email          String?
  logo           String?
  website        String?
  boardType      String?
  status         SchoolStatus @default(TRIAL)
  isActive       Boolean      @default(true)
  onboardingDone Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  branches                  Branch[]
  subscription              Subscription?
  sessions                  AcademicSession[]
  departments               Department[]
  classes                   Class[]
  students                  Student[]
  teachers                  Teacher[]
  invoices                  Invoice[]
  feeCategories             FeeCategory[]
  feeStructures             FeeStructure[]
  fineRules                 FineRule[]
  exams                     Exam[]
  subjects                  Subject[]
  timetables                Timetable[]
  admissions                Admission[]
  notices                   Notice[]
  events                    Event[]
  notifications             Notification[]
  salaries                  Salary[]
  attendance                Attendance[]
  auditLogs                 AuditLog[]
  galleryImages             GalleryImage[]
  testimonials              Testimonial[]
  siteContent               SiteContent[]
  assignments               Assignment[]
  studyMaterials            StudyMaterial[]
  reportTemplates           ReportTemplate[]
  messageTemplates          MessageTemplate[]
  documentRepo              DocumentRepository[]
  communicationTemplates    CommunicationTemplate[]
  communicationLogs         CommunicationLog[]
  subscriptionPayments      SubscriptionPayment[]
  onboardingProgress        OnboardingProgress?
  documents                 Document[]
  activityLogs              ActivityLog[]
  scholarships              Scholarship[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  notificationTemplates     NotificationTemplate[]
  books                     Book[]
  bookIssues                BookIssue[]
  bulkJobs                  BulkJob[]
  templates                 Template[]

  deletedAt   DateTime?
  deletedById String?

  schoolFeatures       SchoolFeature[]
  schoolSettings       SchoolSettings?
  brandSettings        BrandSettings?
  webhookEndpoints     WebhookEndpoint[]
  supportTickets       SupportTicket[]
  certificateTemplates CertificateTemplate[]
  messageThreads       MessageThread[]
  admissionEnquiries   AdmissionEnquiry[]
  visitorLogs          VisitorLog[]
  storageObjects       StorageObject[]
  assetCategories      AssetCategory[]
  vendors              Vendor[]
  assets               Asset[]
  purchaseOrders       PurchaseOrder[]
  systemLogs           SystemLog[]
  contracts            Contract[]
  usageMetrics         UsageMetric[]
  customDomainRecord   CustomDomain?
  consentRecords       ConsentRecord[]
  settingsHistory      SchoolSettingsHistory[]
  archive              SchoolArchive?
  legalHolds           LegalHold[]

  @@map("schools")
}

model Branch {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students     Student[]
  teachers     Teacher[]
  invoices     Invoice[]
  attendances  Attendance[]
  notices      Notice[]
  events       Event[]
  admissions   Admission[]
  salaries     Salary[]
  scholarships Scholarship[]

  deletedAt   DateTime?
  deletedById String?

  @@map("branches")
}

model Subscription {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  planId    String
  amount    Float    @default(0)
  startDate DateTime @default(now())
  endDate   DateTime
  status    String   @default("ACTIVE") // ACTIVE, EXPIRED, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planConfig SubscriptionPlanConfig @relation(fields: [planId], references: [id])
  payments   SubscriptionPayment[]

  @@map("subscriptions")
}

model SubscriptionPlanConfig {
  id           String   @id @default(cuid())
  name         String
  description  String?
  fixedPrice   Float
  billingCycle String // e.g. "MONTHLY", "YEARLY", "ONE_TIME"
  features     String   @default("[]") // JSON array of feature flags
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plan_configs")
}

model SubscriptionPayment {
  id             String   @id @default(cuid())
  schoolId       String
  subscriptionId String
  amountPaid     Float
  paymentMethod  String
  transactionRef String?
  paymentDate    DateTime @default(now())
  remarks        String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

// ═══════════════════════════════════════════
// RBAC & USERS
// ═══════════════════════════════════════════

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  role         Role
  permissionId String
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  name                 String
  role                 Role
  phone                String?
  avatar               String?
  schoolId             String?
  branchId             String?
  employeeId           String?
  department           String?
  isActive             Boolean   @default(true)
  lastLogin            DateTime?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorBackupCodes String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  teacher              Teacher?
  alumni               Alumni?
  guardian             Guardian?
  notices              Notice[]       @relation("NoticeAuthor")
  events               Event[]        @relation("EventCreator")
  auditLogs            AuditLog[]     @relation("AuditUser")
  approvedScholarships Scholarship[]  @relation("ScholarshipApprover")
  refreshTokens        RefreshToken[]
  deletedAt            DateTime?
  deletedById          String?

  sessions                UserSession[]
  supportTickets          SupportTicket[]
  supportMessages         SupportMessage[]
  issuedCertificates      IssuedCertificate[]
  messageParticipants     MessageParticipant[]
  messages                Message[]
  webhookEndpoints        WebhookEndpoint[]
  storageObjects          StorageObject[]
  assetAssignments        AssetAssignment[]        @relation("AssetAssignee")
  assetsAssignedByMe      AssetAssignment[]        @relation("AssetAssigner")
  assetTransfers          AssetTransfer[]
  purchaseOrders          PurchaseOrder[]
  systemLogs              SystemLog[]
  notificationPreferences NotificationPreference[]
  settingsHistoryChanges  SchoolSettingsHistory[]
  archivesCreated         SchoolArchive[]
  legalHoldsPlaced        LegalHold[]              @relation("LegalHoldPlacer")
  legalHoldsReleased      LegalHold[]              @relation("LegalHoldReleaser")

  @@index([role])
  @@index([schoolId])
  @@map("users")
}

// ═══════════════════════════════════════════
// REFRESH TOKENS (Phase 1 — Security)
// ═══════════════════════════════════════════

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique // SHA-256 hash of the actual token
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// OTP for parent login (with brute-force protection)
model OTP {
  id            String    @id @default(cuid())
  phone         String
  code          String
  expiresAt     DateTime
  verified      Boolean   @default(false)
  attemptCount  Int       @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([phone, code])
  @@index([phone, verified])
  @@map("otps")
}

// ═══════════════════════════════════════════
// ACADEMIC STRUCTURE (RELATIONAL)
// ═══════════════════════════════════════════

model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // "2025-2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes                   Class[]
  teacherSubjectAssignments TeacherSubjectAssignment[]

  @@unique([schoolId, name])
  @@map("academic_sessions")
}

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  sessionId String
  name      String // "I", "II", ..., "XII"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sections       Section[]
  classSubjects  ClassSubject[]
  exams          Exam[]
  assignments    Assignment[]
  feeStructures  FeeStructure[]
  studyMaterials StudyMaterial[]

  @@unique([schoolId, sessionId, name])
  @@map("classes")
}

model Section {
  id        String   @id @default(cuid())
  classId   String
  name      String // "A", "B", "C"
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class                     Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  students                  Student[]
  classTeachers             ClassTeacher[]
  timetables                Timetable[]
  attendance                Attendance[]
  teacherSubjectAssignments TeacherSubjectAssignment[]

  @@unique([classId, name])
  @@map("sections")
}

model ClassTeacher {
  id        String   @id @default(cuid())
  sectionId String
  teacherId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([sectionId, teacherId])
  @@map("class_teachers")
}

model Department {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers Teacher[]

  @@unique([schoolId, name])
  @@map("departments")
}

// ═══════════════════════════════════════════
// TEACHER
// ═══════════════════════════════════════════

model Teacher {
  id            String    @id @default(cuid())
  userId        String    @unique
  schoolId      String
  branchId      String?
  departmentId  String?
  employeeId    String?
  designation   String?
  qualification String?
  experience    String?
  subjects      String    @default("")
  joiningDate   DateTime?
  photo         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch                    Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department                Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teacherAttendance         TeacherAttendance[]
  leaveRequests             LeaveRequest[]             @relation("LeaveRequester")
  salaries                  Salary[]
  markedAttendance          Attendance[]               @relation("AttendanceMarker")
  classTeachers             ClassTeacher[]
  teacherSubjects           TeacherSubject[]
  assignments               Assignment[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  deletedAt                 DateTime?
  deletedById               String?

  @@index([schoolId])
  @@map("teachers")
}

// ═══════════════════════════════════════════
// STUDENT & GUARDIAN
// ═══════════════════════════════════════════

model Guardian {
  id              String   @id @default(cuid())
  userId          String?  @unique // linked User for parent portal login
  schoolId        String
  primaryName     String
  primaryPhone    String
  primaryEmail    String?
  primaryRelation String   @default("Father")
  secondaryName   String?
  secondaryPhone  String?
  address         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  students       Student[]
  consentRecords ConsentRecord[]

  @@map("guardians")
}

model Student {
  id          String    @id @default(cuid())
  schoolId    String
  branchId    String?
  sectionId   String?
  guardianId  String?
  rollNo      String
  admissionNo String?   @unique
  password    String?
  name        String
  dob         DateTime?
  gender      String?
  bloodGroup  String?
  address     String?
  photo       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school             School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch             Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sectionRef         Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  guardian           Guardian?              @relation(fields: [guardianId], references: [id])
  attendance         Attendance[]
  marks              StudentMark[]
  invoices           Invoice[]
  submissions        AssignmentSubmission[]
  timelines          StudentTimeline[]
  scholarships       Scholarship[]
  deletedAt          DateTime?
  deletedById        String?
  issuedCertificates IssuedCertificate[]

  @@index([schoolId])
  @@index([sectionId])
  @@index([rollNo, schoolId])
  @@index([admissionNo])
  @@index([schoolId, sectionId])
  @@map("students")
}

model StudentTimeline {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  type        String
  description String?
  date        DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_timeline")
}

// ═══════════════════════════════════════════
// ALUMNI
// ═══════════════════════════════════════════

model Alumni {
  id          String   @id @default(cuid())
  userId      String   @unique
  batch       String
  currentRole String?
  company     String?
  achievement String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions Contribution[]

  @@map("alumni")
}

// ═══════════════════════════════════════════
// ATTENDANCE (STUDENT & TEACHER)
// ═══════════════════════════════════════════

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  schoolId   String
  sectionId  String?
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  markedById String?
  remarks    String?
  createdAt  DateTime         @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section  Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  markedBy Teacher? @relation("AttendanceMarker", fields: [markedById], references: [id])
  branchId String?
  branch   Branch?  @relation(fields: [branchId], references: [id])

  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([schoolId, date])
  @@index([sectionId, date])
  @@map("attendance")
}

model TeacherAttendance {
  id        String           @id @default(cuid())
  teacherId String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime         @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@index([teacherId, date])
  @@map("teacher_attendance")
}

model LeaveRequest {
  id              String      @id @default(cuid())
  requesterId     String
  requesterType   String      @default("TEACHER")
  leaveType       String      @default("CASUAL")
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  approverRemarks String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  requester Teacher @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([status])
  @@index([requesterId, status])
  @@map("leave_requests")
}

// ═══════════════════════════════════════════
// SUBJECT & TIMETABLE
// ═══════════════════════════════════════════

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects             ClassSubject[]
  teacherSubjects           TeacherSubject[]
  examSubjects              ExamSubject[]
  assignments               Assignment[]
  teacherSubjectAssignments TeacherSubjectAssignment[]

  @@map("subjects")
}

model ClassSubject {
  id        String @id @default(cuid())
  classId   String
  subjectId String

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model TeacherSubject {
  id        String @id @default(cuid())
  teacherId String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

model Timetable {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  day       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sectionRef Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slots      TimetableSlot[]

  @@index([schoolId, sectionId])
  @@map("timetables")
}

model TimetableSlot {
  id                         String   @id @default(cuid())
  timetableId                String
  period                     Int
  teacherSubjectAssignmentId String
  startTime                  String
  endTime                    String
  createdAt                  DateTime @default(now())

  timetable                Timetable                @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  teacherSubjectAssignment TeacherSubjectAssignment @relation(fields: [teacherSubjectAssignmentId], references: [id], onDelete: Cascade)

  @@index([timetableId])
  @@index([teacherSubjectAssignmentId])
  @@map("timetable_slots")
}

// ═══════════════════════════════════════════
// EXAM & RESULTS
// ═══════════════════════════════════════════

model Exam {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String
  name        String
  startDate   DateTime?
  endDate     DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classRef     Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  examSubjects ExamSubject[]

  @@index([schoolId, classId])
  @@map("exams")
}

model ExamSubject {
  id                 String    @id @default(cuid())
  examId             String
  subjectId          String
  examDate           DateTime?
  maxMarks           Float     @default(100)
  passMarks          Float     @default(33)
  theoryMaxMarks     Float?
  theoryPassMarks    Float?
  practicalMaxMarks  Float?
  practicalPassMarks Float?
  weightage          Float?

  exam    Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks   StudentMark[]

  @@unique([examId, subjectId])
  @@index([examId])
  @@map("exam_subjects")
}

model StudentMark {
  id                     String  @id @default(cuid())
  studentId              String
  examSubjectId          String
  marksObtained          Float
  grade                  String?
  remarks                String?
  theoryMarksObtained    Float?
  practicalMarksObtained Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, examSubjectId])
  @@index([studentId])
  @@index([examSubjectId])
  @@map("student_marks")
}

// ═══════════════════════════════════════════
// NOTICES & EVENTS
// ═══════════════════════════════════════════

model Notice {
  id         String       @id @default(cuid())
  schoolId   String?
  title      String
  content    String
  category   String       @default("General")
  status     NoticeStatus @default(DRAFT)
  attachment String?
  expiryDate DateTime?
  views      Int          @default(0)
  authorId   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  school   School? @relation(fields: [schoolId], references: [id])
  author   User    @relation("NoticeAuthor", fields: [authorId], references: [id])
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([status, createdAt])
  @@index([category])
  @@index([schoolId, status])
  @@index([createdAt])
  @@map("notices")
}

model Event {
  id          String      @id @default(cuid())
  schoolId    String?
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  venue       String
  category    String      @default("General")
  status      EventStatus @default(PLANNING)
  rsvpCount   Int         @default(0)
  image       String?
  creatorId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  school   School? @relation(fields: [schoolId], references: [id])
  creator  User    @relation("EventCreator", fields: [creatorId], references: [id])
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([date, status])
  @@index([category])
  @@map("events")
}

// ═══════════════════════════════════════════
// FINANCE & FEES
// ═══════════════════════════════════════════

model FeeCategory {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@map("fee_categories")
}

model FeeStructure {
  id         String   @id @default(cuid())
  schoolId   String
  categoryId String
  classId    String?
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school   School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category FeeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  classRef Class?      @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([schoolId, classId])
  @@map("fee_structures")
}

model FineRule {
  id           String   @id @default(cuid())
  schoolId     String
  graceDays    Int      @default(7)
  fineAmount   Float    @default(50.0)
  isPercentage Boolean  @default(false)
  createdAt    DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("fine_rules")
}

model Invoice {
  id              String        @id @default(cuid())
  studentId       String
  schoolId        String
  branchId        String?
  amount          Float
  amountPaid      Float         @default(0)
  remainingAmount Float         @default(0)
  fineAmount      Float         @default(0)
  type            FeeType       @default(MONTHLY)
  description     String?
  status          InvoiceStatus @default(PENDING)
  dueDate         DateTime
  paidDate        DateTime?
  receiptNo       String?
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch       Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  deletedAt    DateTime?
  deletedById  String?

  @@index([studentId])
  @@index([schoolId])
  @@index([status])
  @@index([schoolId, status])
  @@index([dueDate, status])
  @@map("invoices")
}

// ═══════════════════════════════════════════
// ASSIGNMENTS (ENHANCED)
// ═══════════════════════════════════════════

model Assignment {
  id           String    @id @default(cuid())
  schoolId     String
  classId      String?
  teacherId    String?
  title        String
  subjectId    String
  description  String?
  dueDate      DateTime
  maxMarks     Float?
  rubric       String? // JSON rubric criteria
  allowLate    Boolean   @default(false)
  lateDeadline DateTime?
  latePenalty  Float?    @default(0) // percentage deduction
  isPublished  Boolean   @default(true)
  attachment   String? // legacy single attachment
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectRef  Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classRef    Class?                 @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacher     Teacher?               @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  attachments AssignmentAttachment[]
  submissions AssignmentSubmission[]

  @@index([schoolId, classId])
  @@index([teacherId])
  @@map("assignments")
}

model AssignmentAttachment {
  id           String   @id @default(cuid())
  assignmentId String
  fileName     String
  fileUrl      String
  fileType     String // "PDF", "DOC", "IMAGE"
  sizeBytes    Int?
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("assignment_attachments")
}

model AssignmentSubmission {
  id              String           @id @default(cuid())
  assignmentId    String
  studentId       String
  status          AssignmentStatus @default(PENDING)
  submittedAt     DateTime?
  marksObtained   Float?
  grade           String?
  feedback        String? // legacy
  teacherFeedback String? // detailed teacher feedback
  rubricScores    String? // JSON rubric scoring
  isLate          Boolean          @default(false)
  attachment      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model StudyMaterial {
  id           String   @id @default(cuid())
  schoolId     String
  classId      String?
  subjectId    String
  title        String
  description  String?
  fileUrl      String
  fileType     String
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classRef Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([schoolId, classId])
  @@map("study_materials")
}

// ═══════════════════════════════════════════
// ADMISSION
// ═══════════════════════════════════════════

model Admission {
  id               String          @id @default(cuid())
  schoolId         String
  applicantName    String
  applyingForClass String
  dob              DateTime?
  gender           String?
  parentName       String
  parentPhone      String
  parentEmail      String?
  address          String?
  previousSchool   String?
  status           AdmissionStatus @default(PENDING)
  remarks          String?
  reviewedById     String?
  appliedAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  logs        AdmissionLog[]
  branchId    String?
  branch      Branch?        @relation(fields: [branchId], references: [id])
  deletedAt   DateTime?
  deletedById String?

  @@index([schoolId, status])
  @@index([appliedAt])
  @@map("admissions")
}

model AdmissionLog {
  id          String          @id @default(cuid())
  admissionId String
  status      AdmissionStatus
  notes       String?
  changedById String?
  createdAt   DateTime        @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@map("admission_logs")
}

// ═══════════════════════════════════════════
// SALARY & HR
// ═══════════════════════════════════════════

model Salary {
  id         String       @id @default(cuid())
  teacherId  String
  schoolId   String
  month      Int
  year       Int
  basicPay   Float
  allowances Float        @default(0)
  deductions Float        @default(0)
  netPay     Float
  status     SalaryStatus @default(PENDING)
  paidDate   DateTime?
  remarks    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@unique([teacherId, month, year])
  @@index([schoolId, month, year])
  @@index([teacherId, month, year])
  @@index([schoolId, status])
  @@map("salaries")
}

// ═══════════════════════════════════════════
// NOTIFICATION & TEMPLATES
// ═══════════════════════════════════════════

model Notification {
  id             String             @id @default(cuid())
  schoolId       String?
  type           NotificationType
  recipientPhone String?
  recipientEmail String?
  recipientName  String?
  subject        String
  message        String
  status         NotificationStatus @default(QUEUED)
  sentAt         DateTime?
  errorMessage   String?
  templateId     String?
  createdAt      DateTime           @default(now())

  school School? @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@index([type, status])
  @@map("notifications")
}

model MessageTemplate {
  id           String           @id @default(cuid())
  schoolId     String?
  name         String
  category     String // "FEE", "ADMISSION", "EXAM", "ATTENDANCE", "BIRTHDAY"
  channel      NotificationType
  subject      String?
  bodyTemplate String // "Dear {{parentName}}, {{studentName}} has..."
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name, channel])
  @@map("message_templates")
}

// ═══════════════════════════════════════════
// GALLERY, CMS & TESTIMONIALS
// ═══════════════════════════════════════════

model GalleryImage {
  id          String   @id @default(cuid())
  schoolId    String?
  title       String
  category    String   @default("Campus")
  imageUrl    String
  description String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  @@index([category, isPublished])
  @@map("gallery_images")
}

model Contribution {
  id        String   @id @default(cuid())
  alumniId  String
  amount    Float
  purpose   String
  date      DateTime @default(now())
  receiptNo String?
  createdAt DateTime @default(now())

  alumni Alumni @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  @@map("contributions")
}

model SiteContent {
  id        String   @id @default(cuid())
  schoolId  String?
  section   String
  key       String
  value     String
  type      String   @default("text")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, section, key])
  @@map("site_content")
}

model Testimonial {
  id          String   @id @default(cuid())
  schoolId    String?
  name        String
  role        String
  content     String
  avatar      String?
  rating      Int      @default(5)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  @@map("testimonials")
}

// ═══════════════════════════════════════════
// PAYMENTS
// ═══════════════════════════════════════════

model PaymentTransaction {
  id                String    @id @default(cuid())
  invoiceId         String
  amountPaid        Float
  gateway           String    @default("RAZORPAY")
  transactionId     String?   @unique
  razorpaySignature String?
  status            String    @default("CREATED")
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  branchId    String?
  schoolId    String?
  deletedAt   DateTime?
  deletedById String?

  gatewayPaymentId String? @unique

  @@index([invoiceId])
  @@index([transactionId])
  @@map("payment_transactions")
}

// ═══════════════════════════════════════════
// REPORTS & DOCUMENTS
// ═══════════════════════════════════════════

model ReportTemplate {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  type        String // "RECEIPT", "REPORT_CARD", "TC", "BONAFIDE"
  htmlContent String
  cssStyles   String?
  logoUrl     String?
  signature   String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("report_templates")
}

model DocumentRepository {
  id           String    @id @default(cuid())
  schoolId     String
  studentId    String?
  teacherId    String?
  category     String // "TC", "BIRTH_CERT", "AADHAR", "MARKSHEET", "ADMISSION_FORM"
  name         String
  fileUrl      String
  fileType     String
  sizeBytes    Int?
  uploadedById String?
  isVerified   Boolean   @default(false)
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scanStatus String  @default("PENDING")
  scanResult String?

  @@index([schoolId, category])
  @@map("document_repository")
}

// ═══════════════════════════════════════════
// COMMUNICATIONS (PHASE 6)
// ═══════════════════════════════════════════

model CommunicationTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // e.g. "Fee Reminder", "Attendance Alert"
  channel   String // "SMS", "EMAIL", "WHATSAPP"
  subject   String? // For emails
  content   String // Handlebars content
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name, channel])
  @@map("communication_templates")
}

model CommunicationLog {
  id           String   @id @default(cuid())
  schoolId     String
  recipientId  String? // User ID
  recipientNum String? // Phone or Email
  channel      String // "SMS", "EMAIL", "WHATSAPP"
  type         String // "FEE_REMINDER", "GENERAL", etc.
  content      String
  status       String // "PENDING", "SENT", "FAILED", "DELIVERED"
  errorMsg     String?
  sentAt       DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("communication_logs")
}

// ═══════════════════════════════════════════
// AUDIT & SECURITY
// ═══════════════════════════════════════════

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  device    String?
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?   @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, action])
  @@index([userId])
  @@index([schoolId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════
// PHASE 10 STRUCTURAL MODELS
// ═══════════════════════════════════════════

model TeacherSubjectAssignment {
  id                String   @id @default(cuid())
  schoolId          String
  teacherId         String
  subjectId         String
  sectionId         String
  academicSessionId String
  createdAt         DateTime @default(now())

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher         Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  timetableSlots  TimetableSlot[]

  @@unique([teacherId, subjectId, sectionId, academicSessionId])
  @@map("teacher_subject_assignments")
}

model OnboardingProgress {
  id                       String  @id @default(cuid())
  schoolId                 String  @unique
  profileCompleted         Boolean @default(false)
  academicSetupCompleted   Boolean @default(false)
  classesSectionsCompleted Boolean @default(false)
  teachersAdded            Boolean @default(false)
  studentsImported         Boolean @default(false)
  feeStructureSetup        Boolean @default(false)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model Document {
  id         String            @id @default(cuid())
  schoolId   String
  ownerType  DocumentOwnerType
  ownerId    String
  category   DocumentCategory
  fileUrl    String
  title      String?
  uploadedBy String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model ActivityLog {
  id          String       @id @default(cuid())
  schoolId    String
  type        ActivityType
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([type])
  @@map("activity_logs")
}

model Scholarship {
  id         String   @id @default(cuid())
  schoolId   String
  branchId   String?
  studentId  String
  name       String
  amount     Float
  percentage Float?
  reason     String?
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?   @relation("ScholarshipApprover", fields: [approvedBy], references: [id])

  @@map("scholarships")
}

model NotificationTemplate {
  id        String           @id @default(cuid())
  schoolId  String
  name      String
  type      NotificationType
  content   String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("notification_templates")
}

// ═══════════════════════════════════════════
// LIBRARY MANAGEMENT (PHASE 4)
// ═══════════════════════════════════════════

model Book {
  id            String   @id @default(cuid())
  schoolId      String
  title         String
  author        String
  isbn          String?
  publisher     String?
  category      String   @default("General")
  totalCopies   Int      @default(1)
  available     Int      @default(1)
  shelfLocation String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issues BookIssue[]

  @@index([schoolId, category])
  @@index([title])
  @@map("books")
}

model BookIssue {
  id         String    @id @default(cuid())
  bookId     String
  schoolId   String
  userId     String // Polymorphic: can be Student or Teacher ID
  userType   String    @default("STUDENT")
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String    @default("ISSUED") // ISSUED, RETURNED, OVERDUE, LOST
  fineAmount Float     @default(0)
  createdAt  DateTime  @default(now())

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([userId])
  @@map("book_issues")
}

// ═══════════════════════════════════════════
// PHASE 11A: BACKUPS, BULK JOBS & UNIFIED COMM
// ═══════════════════════════════════════════

model SystemBackup {
  id        String   @id @default(cuid())
  type      String // "DATABASE" or "STORAGE"
  status    String // "IN_PROGRESS", "COMPLETED", "FAILED"
  sizeBytes Int?
  fileUrl   String?
  errorMsg  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("system_backups")
}

model BulkJob {
  id          String   @id @default(cuid())
  schoolId    String
  type        String // "STUDENT_IMPORT", "TEACHER_IMPORT"
  status      String // "QUEUED", "PROCESSING", "COMPLETED", "FAILED"
  progress    Int      @default(0)
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  failedRows  Int      @default(0)
  errorFile   String? // CSV of failed rows
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("bulk_jobs")
}

model Template {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  channel   String // "SMS", "EMAIL", "WHATSAPP", "NOTICE"
  subject   String?
  content   String // Handlebars content
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name, channel])
  @@map("unified_templates")
}

model UserSession {
  id                String   @id @default(cuid())
  userId            String
  sessionId         String   @unique
  refreshFamily     String?
  deviceName        String?
  deviceFingerprint String?
  browser           String?
  os                String?
  ipAddress         String?
  country           String?
  city              String?
  lastSeen          DateTime @default(now())
  isActive          Boolean  @default(true)
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("user_sessions")
}

model AdmissionEnquiry {
  id               String   @id @default(cuid())
  schoolId         String
  studentName      String
  parentName       String
  phone            String
  email            String?
  applyingForClass String?
  source           String? // Walk-in, Website, Referral
  status           String   @default("OPEN") // OPEN, CONTACTED, CLOSED, CONVERTED
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("admission_enquiries")
}

model VisitorLog {
  id           String    @id @default(cuid())
  schoolId     String
  visitorName  String
  phone        String
  purpose      String
  personToMeet String?
  checkIn      DateTime  @default(now())
  checkOut     DateTime?
  remarks      String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("visitor_logs")
}

model WebhookEndpoint {
  id         String   @id @default(cuid())
  schoolId   String? // Optional: If null, it's a global webhook
  url        String
  secret     String
  events     String[] // Array of event names
  enabled    Boolean  @default(true)
  retryCount Int      @default(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([schoolId, enabled])
  @@map("webhook_endpoints")
}

model ScheduledJob {
  id        String    @id @default(cuid())
  name      String
  status    String    @default("ACTIVE") // ACTIVE, PAUSED
  lastRunAt DateTime?
  nextRunAt DateTime?
  failures  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("scheduled_jobs")
}

model SupportTicket {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String // User who created the ticket
  subject   String
  status    String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority  String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]
  deletedAt   DateTime?
  deletedById String?

  @@index([schoolId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id           String   @id @default(cuid())
  ticketId     String
  senderId     String
  content      String
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

model CertificateTemplate {
  id          String   @id @default(cuid())
  schoolId    String
  name        String // e.g., Bonafide, Transfer
  contentHtml String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issued IssuedCertificate[]

  @@index([schoolId])
  @@map("certificate_templates")
}

model IssuedCertificate {
  id               String   @id @default(cuid())
  templateId       String
  studentId        String
  issuedById       String
  qrHash           String   @unique
  status           String   @default("VALID") // VALID, REVOKED
  revocationReason String?
  issuedAt         DateTime @default(now())

  template CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  student  Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy User                @relation(fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([studentId])
  @@map("issued_certificates")
}

model MessageThread {
  id        String   @id @default(cuid())
  schoolId  String
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants MessageParticipant[]

  @@index([schoolId])
  @@map("message_threads")
}

model MessageParticipant {
  id              String    @id @default(cuid())
  threadId        String
  userId          String
  participantRole String?
  joinedAt        DateTime  @default(now())
  lastReadAt      DateTime?

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("message_participants")
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  thread      MessageThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]
  reads       MessageReadReceipt[]

  @@index([threadId])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileUrl   String
  fileName  String
  fileSize  Int
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model MessageReadReceipt {
  id            String   @id @default(cuid())
  messageId     String
  participantId String
  readAt        DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId])
  @@map("message_read_receipts")
}

model FeatureFlag {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  description       String?
  category          String   @default("GENERAL")
  defaultEnabled    Boolean  @default(false)
  rolloutPercentage Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  schoolFeatures SchoolFeature[]

  @@map("feature_flags")
}

model SchoolFeature {
  id        String   @id @default(cuid())
  schoolId  String
  featureId String
  isEnabled Boolean  @default(true)
  enabledAt DateTime @default(now())
  enabledBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feature FeatureFlag @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([schoolId, featureId])
  @@map("school_features")
}

model SchoolSettings {
  id                 String   @id @default(cuid())
  schoolId           String   @unique
  timezone           String   @default("Asia/Kolkata")
  dateFormat         String   @default("DD/MM/YYYY")
  currency           String   @default("INR")
  academicYear       String?
  language           String   @default("en")
  academicYearFormat String?
  attendanceMethod   String   @default("DAILY")
  gradingSystem      String   @default("PERCENTAGE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

model BrandSettings {
  id             String   @id @default(cuid())
  schoolId       String   @unique
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  logoUrl        String?
  faviconUrl     String?
  customDomain   String?  @unique
  loginBannerUrl String?
  websiteUrl     String?
  emailFooter    String?
  emailDomain    String?
  senderName     String?
  replyTo        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

model SchoolRegistrationRequest {
  id            String   @id @default(cuid())
  schoolName    String
  email         String   @unique
  principalName String?
  phone         String?
  address       String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("school_registration_requests")
}

// ═══════════════════════════════════════════
// PHASE 14B: STORAGE & ASSET MANAGEMENT
// ═══════════════════════════════════════════

model StorageObject {
  id         String   @id @default(cuid())
  key        String   @unique
  bucket     String
  size       Int
  mimeType   String
  uploadedBy String
  schoolId   String
  scanStatus String   @default("PENDING")
  checksum   String?
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([uploadedBy])
  @@map("storage_objects")
}

model AssetCategory {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@map("asset_categories")
}

model Vendor {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assets         Asset[]
  purchaseOrders PurchaseOrder[]
  deletedAt      DateTime?
  deletedById    String?

  @@map("vendors")
}

model Asset {
  id           String    @id @default(cuid())
  schoolId     String
  categoryId   String
  vendorId     String?
  name         String
  description  String?
  serialNumber String?
  status       String    @default("AVAILABLE") // AVAILABLE, ASSIGNED, MAINTENANCE, RETIRED
  purchaseDate DateTime?
  warrantyEnd  DateTime?
  cost         Float?
  location     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category       AssetCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendor         Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  assignments    AssetAssignment[]
  maintenance    MaintenanceRecord[]
  transfers      AssetTransfer[]
  depreciations  AssetDepreciation[]
  purchaseItem   PurchaseOrderItem?  @relation(fields: [purchaseItemId], references: [id])
  purchaseItemId String?
  deletedAt      DateTime?
  deletedById    String?

  @@map("assets")
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  userId     String // The person it's assigned to
  assignedBy String // The person who assigned it
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation("AssetAssignee", fields: [userId], references: [id], onDelete: Cascade)
  admin User  @relation("AssetAssigner", fields: [assignedBy], references: [id], onDelete: Cascade)

  @@map("asset_assignments")
}

model AssetTransfer {
  id            String   @id @default(cuid())
  assetId       String
  fromLocation  String?
  toLocation    String?
  fromBranchId  String?
  toBranchId    String?
  transferredBy String
  transferredAt DateTime @default(now())
  reason        String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [transferredBy], references: [id], onDelete: Cascade)

  @@map("asset_transfers")
}

model AssetDepreciation {
  id           String   @id @default(cuid())
  assetId      String
  date         DateTime
  valueBefore  Float
  depreciation Float
  valueAfter   Float
  method       String   @default("STRAIGHT_LINE")
  createdAt    DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_depreciations")
}

model MaintenanceRecord {
  id          String    @id @default(cuid())
  assetId     String
  type        String    @default("REPAIR") // REPAIR, ROUTINE, UPGRADE
  description String
  cost        Float?
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  performedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("maintenance_records")
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  schoolId     String
  vendorId     String
  poNumber     String    @unique
  status       String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, FULFILLED
  totalAmount  Float     @default(0)
  expectedDate DateTime?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vendor Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items  PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String @id @default(cuid())
  poId        String
  description String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  status      String @default("PENDING") // PENDING, RECEIVED

  po    PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  asset Asset[]

  @@map("purchase_order_items")
}

// ═══════════════════════════════════════════
// PHASE 14C: OPERATIONAL RELIABILITY
// ═══════════════════════════════════════════

model FailedJob {
  id         String   @id @default(cuid())
  queueName  String
  jobId      String?
  payload    String // JSON stringified payload
  error      String
  stackTrace String?
  failedAt   DateTime @default(now())
  status     String   @default("FAILED") // FAILED, RETRIED, RESOLVED

  @@map("failed_jobs")
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String // INFO, WARN, ERROR, FATAL
  module    String // e.g., "QUEUE", "BACKUP", "DB", "AUTH"
  message   String
  metadata  String? // JSON string
  schoolId  String?
  userId    String?
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level])
  @@index([module])
  @@map("system_logs")
}

// ═══════════════════════════════════════════
// PHASE 14D: SAAS MONETIZATION & LIFECYCLE
// ═══════════════════════════════════════════

model Contract {
  id           String    @id @default(cuid())
  schoolId     String
  startDate    DateTime
  endDate      DateTime
  billingCycle String    @default("MONTHLY") // MONTHLY, YEARLY
  amount       Float
  currency     String    @default("INR")
  status       String    @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED
  autoRenew    Boolean   @default(true)
  signedAt     DateTime?
  documentUrl  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("contracts")
}

model UsageMetric {
  id              String    @id @default(cuid())
  schoolId        String
  month           DateTime // First day of the month
  students        Int       @default(0)
  smsUsed         Int       @default(0)
  emailUsed       Int       @default(0)
  whatsappUsed    Int       @default(0)
  apiCalls        Int       @default(0)
  activeUsers     Int       @default(0)
  documentsStored Int       @default(0)
  storageBytes    BigInt    @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  deletedById     String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, month])
  @@map("usage_metrics")
}

model CustomDomain {
  id         String    @id @default(cuid())
  schoolId   String    @unique
  domain     String    @unique
  status     String    @default("PENDING") // PENDING, ACTIVE, FAILED
  sslStatus  String    @default("PENDING") // PENDING, ISSUED, FAILED
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("custom_domains")
}

// ═══════════════════════════════════════════
// PHASE 14F: ADVANCED ENTERPRISE
// ═══════════════════════════════════════════

model ConsentRecord {
  id         String   @id @default(cuid())
  guardianId String
  schoolId   String
  type       String // SMS, EMAIL, WHATSAPP, MARKETING
  accepted   Boolean
  acceptedAt DateTime @default(now())
  ipAddress  String?

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("consent_records")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  type      String // FEE_REMINDER, ATTENDANCE, EXAM, MARKETING
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model SchoolSettingsHistory {
  id           String   @id @default(cuid())
  schoolId     String
  changedBy    String
  previousData String // JSON string
  newData      String // JSON string
  changedAt    DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [changedBy], references: [id], onDelete: Cascade)

  @@map("school_settings_history")
}

model SchoolArchive {
  id         String   @id @default(cuid())
  schoolId   String   @unique
  status     String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, RESTORED
  archiveUrl String?
  archivedBy String
  archivedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [archivedBy], references: [id], onDelete: Cascade)

  @@map("school_archives")
}

model LegalHold {
  id         String    @id @default(cuid())
  schoolId   String
  reason     String
  placedBy   String
  placedAt   DateTime  @default(now())
  releasedAt DateTime?
  releasedBy String?
  status     String    @default("ACTIVE") // ACTIVE, RELEASED

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User   @relation("LegalHoldPlacer", fields: [placedBy], references: [id], onDelete: Cascade)
  releaser User?  @relation("LegalHoldReleaser", fields: [releasedBy], references: [id], onDelete: SetNull)

  @@map("legal_holds")
}
