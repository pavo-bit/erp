# ═══════════════════════════════════════════════════════════════════════
# SSVM Backend — Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@pgbouncer:6432/ssvm_platform?pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgrespassword@database:5432/ssvm_platform"

# RSA JWT keys — generate with `npx tsx scripts/generate-rsa-keypair.ts`.
# Keep private keys secret; never commit a populated .env file.
ACCESS_TOKEN_PRIVATE_KEY=""
ACCESS_TOKEN_PUBLIC_KEY=""
REFRESH_TOKEN_PRIVATE_KEY=""
REFRESH_TOKEN_PUBLIC_KEY=""

# Database roles: runtime app must be NOBYPASSRLS; trusted role is separate.
TRUSTED_DATABASE_URL=""

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Upload folder
UPLOAD_DIR="./uploads"

# Environment
NODE_ENV="development"
