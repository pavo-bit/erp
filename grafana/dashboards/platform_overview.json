{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "Platform Overview",
  "uid": "ssvm_platform_overview",
  "tags": ["ssvm", "platform", "overview"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Active Schools",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "name": "PostgreSQL" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT active_schools AS \"Schools\" FROM platform_metrics.platform_overview_v;",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Enrolled Students",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "postgres", "name": "PostgreSQL" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT total_students AS \"Students\" FROM platform_metrics.platform_overview_v;",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total Faculty & Teachers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "postgres", "name": "PostgreSQL" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT total_faculty AS \"Faculty\" FROM platform_metrics.platform_overview_v;",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Registered Platform Users",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "name": "PostgreSQL" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT total_users AS \"Users\" FROM platform_metrics.platform_overview_v;",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Active Support Sessions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "ssvm_support_sessions_active or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Overall Platform Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ssvm_http_request_duration_seconds_count[1m])) or vector(0)",
          "legendFormat": "Total RPS",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Process Resident Memory (RSS MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "ssvm_process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "RSS Memory (MB)",
          "refId": "A"
        }
      ]
    }
  ]
}
