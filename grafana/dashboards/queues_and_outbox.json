{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "Queues & Outbox",
  "uid": "ssvm_queues_and_outbox",
  "tags": ["ssvm", "workers", "queues", "outbox"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "BullMQ Queue Backlog",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "sum(ssvm_bullmq_queue_size) or vector(0)",
          "legendFormat": "Backlog",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Outbox Dead Letters",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "ssvm_outbox_dead_letters_total or vector(0)",
          "legendFormat": "Dead Letters",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Outbox Processed Events Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ssvm_outbox_events_total{status=\"published\"}[5m])) or vector(0)",
          "legendFormat": "Published/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Outbox Failure Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ssvm_outbox_events_total{status=\"failed\"}[5m])) or vector(0)",
          "legendFormat": "Failed/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "BullMQ Queue Sizes by Queue",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "ssvm_bullmq_queue_size",
          "legendFormat": "{{ queue }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "BullMQ Job Processing Latency p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ssvm_bullmq_job_duration_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "{{ queue }} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Transactional Outbox Event Rate by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ssvm_outbox_events_total[5m])) by (status)",
          "legendFormat": "{{ status }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Outbox Queue Database Status Breakdown",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "postgres", "name": "PostgreSQL" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT status, event_count AS \"Count\", oldest_event_at AS \"Oldest\", newest_event_at AS \"Newest\" FROM platform_metrics.outbox_queue_stats_v ORDER BY status;",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" }
}
