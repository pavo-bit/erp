{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "API Performance",
  "uid": "ssvm_api_performance",
  "tags": ["ssvm", "api", "sli"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Request Throughput by Route (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ssvm_http_request_duration_seconds_count[1m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "API Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ssvm_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p50 (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ssvm_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95 (ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ssvm_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p99 (ms)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Errors (4xx & 5xx) by Route & Code",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ssvm_http_errors_total[1m])) by (route, code)",
          "legendFormat": "{{route}} [{{code}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Concurrent HTTP Connections",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "expr": "ssvm_http_active_connections or vector(0)",
          "refId": "A"
        }
      ]
    }
  ]
}
