    {
      "id": 5,
      "title": "Throughput (req/s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum(rate(ssvm_http_request_duration_seconds_count[1m])) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#ec4899", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Backend RSS Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "ssvm_process_resident_memory_bytes / 1024 / 1024",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10b981", "value": null },
              { "color": "#f59e0b", "value": 500 },
              { "color": "#ef4444", "value": 1024 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Real-Time Traffic by Route (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum(rate(ssvm_http_request_duration_seconds_count[1m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "gradientMode": "opacity"
          }
        }
      }
    },
    {
      "id": 8,
      "title": "API Latency Quantiles (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ssvm_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P50 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ssvm_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ssvm_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P99 Latency",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "gradientMode": "opacity"
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Fee Invoices by Status",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT status AS \"Status\", count(id) AS \"Invoices\" FROM invoices GROUP BY status ORDER BY 2 DESC;",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "groupWidth": 0.7
      }
    },
    {
      "id": 10,
      "title": "User Accounts by Role",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT role AS \"Role\", count(id) AS \"Users\" FROM users GROUP BY role ORDER BY 2 DESC;",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "groupWidth": 0.7
      }
    },
    {
      "id": 11,
      "title": "Node.js Process & Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "ssvm_process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "RSS Memory (MB)",
          "refId": "A"
        },
        {
          "expr": "ssvm_nodejs_heap_size_used_bytes / 1024 / 1024",
          "legendFormat": "Heap Used (MB)",
          "refId": "B"
        },
        {
          "expr": "ssvm_nodejs_heap_size_total_bytes / 1024 / 1024",
          "legendFormat": "Heap Total (MB)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    }
  ],
